# Generated by Cargo
# will have compiled files and executables
target/

# Java build artifacts (liteforge-java)
crates/liteforge-java/build/

# napi-rs built native artifacts (liteforge-js). Generated TS/JS bindings
# (index.js, index.d.ts) are tracked so they ship in the npm tarball.
crates/liteforge-js/*.node

# LaTeX build intermediates (PDFs are kept; aux/log/out/toc are not)
docs/latex/*.aux
docs/latex/*.log
docs/latex/*.out
docs/latex/*.toc

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store Windows debug info
*.pdb

# RustRover
.idea/

# VS Code
.vscode/

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Cursor (personal skills/rules; mirrors ~/.cursor)
.cursor/

# .devcontainer/ is intentionally committed

# Python virtual environments
.venv/
__pycache__/
*.pyc

# Node
node_modules/

# Generated docs site
site/

# Local artifacts
release-assets/
demo/
benchmarks/results/
benchmarks/aggregate_results.py
benchmarks/comprehensive_speed_test.py
benchmarks/js_speed_test.mjs

# Junk
null

# npm auth — never commit
.npmrc
**/.npmrc

# Build output (wheels/sdist) - never commit; built fresh in CI
dist/
