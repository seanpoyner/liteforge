{
  "name": "LiteForge",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installGradle": true,
      "installMaven": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "redhat.vscode-yaml",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.targetDir": true,
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        },
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/.gradle/**": true
        }
      }
    }
  },
  "mounts": [
    "source=liteforge-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=liteforge-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=liteforge-target,target=${containerWorkspaceFolder}/target,type=volume"
  ],
  "postCreateCommand": ".devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "forwardPorts": [8080, 3000],
  "portsAttributes": {
    "8080": { "label": "forge serve" },
    "3000": { "label": "dev" }
  }
}
